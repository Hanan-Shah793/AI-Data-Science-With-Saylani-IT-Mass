   "source": [
    "# Remove Duplicates from List :"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "156458ec",
   "metadata": {},
   "outputs": [],
   "source": [
    "items = [3, 1, 3, 2, 1, 5, 2]\n",
    "\n",
    "new_items = []\n",
    "\n",
    "for num in items:\n",
    "    if num not in new_items:\n",
    "        new_items.append(num)\n",
    "print(\"original item list:\" , items)\n",
    "print(\"updated items list:\" , new_items)\n",
    "          \n",
    "        \n",
    "        \n",
    "\n",
    "        "
   ]
  }
